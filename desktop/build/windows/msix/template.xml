<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="agent-builder.exe"
        Arguments=""
        InstallLocation="C:\Program Files\CIPFZ\Agent Builder">
    </Installer>
    <PackageInformation
        PackageName="Agent Builder"
        PackageDisplayName="Agent Builder"
        PublisherName="CN=CIPFZ"
        PublisherDisplayName="CIPFZ"
        Version="0.1.0.0"
        PackageDescription="Agentic operations desktop client">
        <Capabilities>
            <Capability Name="runFullTrust" />

        </Capabilities>
        <Applications>
            <Application
                Id="com.cipfz.agentbuilder"
                Description="Agentic operations desktop client"
                DisplayName="Agent Builder"
                ExecutableName="agent-builder.exe"
                EntryPoint="Windows.FullTrustApplication">

            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Agent Builder</DisplayName>
            <PublisherDisplayName>CIPFZ</PublisherDisplayName>
            <Description>Agentic operations desktop client</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="agent-builder.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
