{
  "config": {
    "version": 1
  },
  "server": {
    "http_addr": "127.0.0.1:18080",
    "ws_path": "/ws",
    "request_timeout_ms": 300000,
    "retry_max_retries": 3,
    "retry_base_delay_ms": 500,
    "retry_max_delay_ms": 4000
  },
  "runtime": {
    "max_turns": 100
  },
  "llm": {
    "default_profile": "minimax_main",
    "active_profile": "minimax_main",
    "providers": {
      "minimax": {
        "protocol": "anthropic",
        "base_url": "https://api.minimaxi.com/anthropic/v1/messages",
        "api_key": "${MINIMAX_API_KEY}",
        "api_version": "2023-06-01",
        "enabled": true,
        "timeout_ms": 60000,
        "max_retries": 2,
        "headers": {}
      }
    },
    "profiles": {
      "minimax_main": {
        "provider": "minimax",
        "model": "MiniMax-M2.7",
        "streaming": true
      }
    },
    "routing": {
      "default_profile": "minimax_main",
      "agent_profiles": {
        "worker": "minimax_main",
        "review": "minimax_main",
        "frontend": "minimax_main"
      }
    }
  },
  "permissions": {
    "mode": "workspace-write",
    "subagent_mode": "ask",
    "plan_mode": false,
    "auto_mode": false,
    "workspace_roots": [
      "."
    ],
    "dangerous_command_patterns": [
      "rm -rf",
      "del /f /s",
      "format",
      "shutdown",
      "reboot",
      "powershell -enc"
    ]
  },
  "mcp": {
    "enabled": true,
    "skills_enabled": true
  },
  "compact": {
    "verification_mode": false
  }
}
